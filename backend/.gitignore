node_modules/

# Env / secrets — el patrón .env.* cubre .env.production,
# .env.development, .env.test, .env.local, etc. Plantilla sube.
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Build output
dist/
build/

# multer upload landing zone — runtime artifact, not source
uploads/

# Caches / temp
.cache/
tmp/
temp/

# DB dumps / backups generados durante desarrollo
*.bak
*.dump
*.sql.bak
*.sqlite
*.sqlite-journal

# Smokes XLSX — archivos temporales del live-smoke que a veces
# quedan cuando ctrl+C interrumpe la prueba.
*-smoke.xlsx

# Lock files de gestores que NO usamos.
yarn.lock
pnpm-lock.yaml
